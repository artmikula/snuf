{
  "name": "snuf",
  "version": "0.1.0",
  "description": "Sniff out what AI agents can reach on your machine. Agents, MCP servers, exposed secrets, file access, shell permissions. One command, zero network calls.",
  "type": "module",
  "bin": {
    "snuf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "ai",
    "security",
    "agent",
    "mcp",
    "audit",
    "claude",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "windsurf",
    "gemini-cli",
    "openclaw",
    "devtools",
    "cli",
    "secrets",
    "scanner"
  ],
  "author": "Art <contact@centipede.dev> (https://centipede.dev)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artmikula/snuf.git"
  },
  "homepage": "https://github.com/artmikula/snuf#readme",
  "bugs": {
    "url": "https://github.com/artmikula/snuf/issues"
  }
}
